#!/usr/bin/env python3
import os
import sys
import json

def hex_to_argb_int(hex_str):
    hex_str = hex_str.strip().lstrip("#")
    r, g, b = (int(hex_str[i:i+2], 16) for i in (0, 2, 4))
    val = (0xFF << 24) | (r << 16) | (g << 8) | b
    return val - (1 << 32) if val > 0x7FFFFFFF else val

def main():
    colors_file = sys.argv[1] if len(sys.argv) > 1 else os.path.expanduser("~/.local/state/matugen/brave-colors.json")
    if not os.path.exists(colors_file):
        return

    with open(colors_file) as f:
        primary = json.load(f).get("primary")
    if not primary:
        return

    argb_val = hex_to_argb_int(primary)

    for p in [
        os.path.expanduser("~/.config/BraveSoftware/Brave-Origin/Default/Preferences"),
        os.path.expanduser("~/.config/BraveSoftware/Brave-Browser/Default/Preferences")
    ]:
        if not os.path.exists(p):
            continue
        try:
            with open(p, "r", encoding="utf-8") as f:
                prefs = json.load(f)

            prefs.setdefault("browser", {}).setdefault("theme", {})
            prefs["browser"]["theme"].update({
                "user_color2": argb_val,
                "color_scheme2": 2,
                "color_variant2": 1
            })
            prefs.setdefault("extensions", {}).setdefault("theme", {})
            prefs["extensions"]["theme"]["id"] = "user_color_theme_id"

            with open(p, "w", encoding="utf-8") as f:
                json.dump(prefs, f, separators=(",", ":"))
        except Exception:
            pass

if __name__ == "__main__":
    main()
