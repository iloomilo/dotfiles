{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/anime_logo_small.txt",
        "padding": {
            "right": 2
        }
    },
    "display": {
        "separator": " \u001b[90m\u2502\u001b[0m ",
        "size": {
            "ndigits": 1
        }
    },
    "modules": [
        "break",
        "break",
        "break",
        "break",
        "break",
        "break",
        "break",
        "break",
        "break",
        "break",
        "break",
        "break",
        "break",
        "break",
        "break",
        {
            "type": "title",
            "key": "\u001b[34m \uf007 user    \u001b[0m",
            "format": "\u001b[37m{user-name}\u001b[90m@\u001b[37m{host-name}\u001b[0m"
        },
        {
            "type": "host",
            "key": "\u001b[32m \udb80\udf22 host    \u001b[0m",
            "format": "\u001b[37m{version}\u001b[0m"
        },
        {
            "type": "os",
            "key": "\u001b[36m \udb83\udec0 distro  \u001b[0m",
            "format": "\u001b[37m{pretty-name}\u001b[0m"
        },
        {
            "type": "kernel",
            "key": "\u001b[35m \uf473 kernel  \u001b[0m",
            "format": "\u001b[37m{release}\u001b[0m"
        },
        {
            "type": "wm",
            "key": "\u001b[33m \uf009 wm      \u001b[0m",
            "format": "\u001b[37m{pretty-name}\u001b[0m"
        },
        {
            "type": "terminal",
            "key": "\u001b[34m \udb80\udd1b term    \u001b[0m",
            "format": "\u001b[37m{pretty-name}\u001b[0m"
        },
        {
            "type": "editor",
            "key": "\u001b[32m \uf36f editor  \u001b[0m",
            "format": "\u001b[37m{name}\u001b[0m"
        },
        {
            "type": "shell",
            "key": "\u001b[36m \uf489 shell   \u001b[0m",
            "format": "\u001b[37m{pretty-name}\u001b[0m"
        },
        {
            "type": "memory",
            "key": "\u001b[35m \uefc5 memory  \u001b[0m",
            "format": "\u001b[37m{used} / {total}\u001b[0m"
        },
        {
            "type": "colors",
            "key": "\u001b[90m \udb80\udf5c colors  \u001b[0m",
            "symbol": "circle"
        }
    ]
}