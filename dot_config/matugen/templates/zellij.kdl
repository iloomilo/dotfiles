themes {
    matugen {
        fg "{{colors.on_surface.default.hex}}"
        bg "{{colors.surface.default.hex}}"
        black "{{colors.surface_container_lowest.default.hex}}"
        red "{{colors.error.default.hex}}"
        green "{{colors.primary.default.hex}}"
        yellow "{{colors.tertiary_fixed.default.hex}}"
        blue "{{colors.primary_fixed.default.hex}}"
        magenta "{{colors.tertiary.default.hex}}"
        cyan "{{colors.secondary.default.hex}}"
        white "{{colors.on_surface.default.hex}}"
        orange "{{colors.tertiary.default.hex}}"

        text_unselected {
            base "{{colors.on_surface.default.hex}}"
            background "{{colors.surface.default.hex}}"
            emphasis_0 "{{colors.tertiary.default.hex}}"
            emphasis_1 "{{colors.secondary.default.hex}}"
            emphasis_2 "{{colors.primary.default.hex}}"
            emphasis_3 "{{colors.tertiary_fixed.default.hex}}"
        }
        text_selected {
            base "{{colors.on_surface.default.hex}}"
            background "{{colors.surface_container_highest.default.hex}}"
            emphasis_0 "{{colors.tertiary.default.hex}}"
            emphasis_1 "{{colors.secondary.default.hex}}"
            emphasis_2 "{{colors.primary.default.hex}}"
            emphasis_3 "{{colors.tertiary_fixed.default.hex}}"
        }
        ribbon_selected {
            base "{{colors.on_primary.default.hex}}"
            background "{{colors.primary.default.hex}}"
            emphasis_0 "{{colors.on_primary.default.hex}}"
            emphasis_1 "{{colors.on_primary.default.hex}}"
            emphasis_2 "{{colors.on_primary.default.hex}}"
            emphasis_3 "{{colors.on_primary.default.hex}}"
        }
        ribbon_unselected {
            base "{{colors.on_surface_variant.default.hex}}"
            background "{{colors.surface_container.default.hex}}"
            emphasis_0 "{{colors.primary.default.hex}}"
            emphasis_1 "{{colors.tertiary.default.hex}}"
            emphasis_2 "{{colors.secondary.default.hex}}"
            emphasis_3 "{{colors.on_surface.default.hex}}"
        }
        table_title {
            base "{{colors.primary.default.hex}}"
            background "{{colors.surface.default.hex}}"
            emphasis_0 "{{colors.tertiary.default.hex}}"
            emphasis_1 "{{colors.secondary.default.hex}}"
            emphasis_2 "{{colors.primary.default.hex}}"
            emphasis_3 "{{colors.tertiary_fixed.default.hex}}"
        }
        table_cell_selected {
            base "{{colors.on_surface.default.hex}}"
            background "{{colors.surface_container_highest.default.hex}}"
            emphasis_0 "{{colors.tertiary.default.hex}}"
            emphasis_1 "{{colors.secondary.default.hex}}"
            emphasis_2 "{{colors.primary.default.hex}}"
            emphasis_3 "{{colors.tertiary_fixed.default.hex}}"
        }
        table_cell_unselected {
            base "{{colors.on_surface.default.hex}}"
            background "{{colors.surface.default.hex}}"
            emphasis_0 "{{colors.tertiary.default.hex}}"
            emphasis_1 "{{colors.secondary.default.hex}}"
            emphasis_2 "{{colors.primary.default.hex}}"
            emphasis_3 "{{colors.tertiary_fixed.default.hex}}"
        }
        list_selected {
            base "{{colors.on_surface.default.hex}}"
            background "{{colors.surface_container_highest.default.hex}}"
            emphasis_0 "{{colors.tertiary.default.hex}}"
            emphasis_1 "{{colors.secondary.default.hex}}"
            emphasis_2 "{{colors.primary.default.hex}}"
            emphasis_3 "{{colors.tertiary_fixed.default.hex}}"
        }
        list_unselected {
            base "{{colors.on_surface.default.hex}}"
            background "{{colors.surface.default.hex}}"
            emphasis_0 "{{colors.tertiary.default.hex}}"
            emphasis_1 "{{colors.secondary.default.hex}}"
            emphasis_2 "{{colors.primary.default.hex}}"
            emphasis_3 "{{colors.tertiary_fixed.default.hex}}"
        }
    }
}
